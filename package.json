{
  "name": "tactone",
  "version": "0.1.1",
  "description": "Interface sounds you can shape. One config at the root, synthesized live, no audio files.",
  "license": "MIT",
  "author": "Deepanshu Mishra",
  "homepage": "https://github.com/DeepanshuMishraa/tactone#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepanshuMishraa/tactone.git"
  },
  "bugs": {
    "url": "https://github.com/DeepanshuMishraa/tactone/issues"
  },
  "keywords": [
    "sound",
    "audio",
    "ui-sounds",
    "interface-sounds",
    "sound-effects",
    "web-audio",
    "synthesizer",
    "react"
  ],
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "skills"
  ],
  "bin": {
    "tactone": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "default": "./dist/presets.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit && biome check . && vitest run && pnpm check:package",
    "check:package": "tsc -p tsconfig.build.json && node scripts/declarations.mjs && tsc -p tsconfig.cli.json && tsc -p test/consumer/tsconfig.json",
    "format": "biome check --write .",
    "test": "vitest run",
    "gains": "bun scripts/gains.ts && biome format --write src/gains.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/declarations.mjs && tsc -p tsconfig.cli.json && vite build editor",
    "prepack": "pnpm build",
    "editor": "vite editor",
    "site": "vite site",
    "site:build": "vite build site",
    "site:deploy": "vite build site && wrangler deploy -c site/wrangler.jsonc",
    "tactone": "node dist/cli.js"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "torph": "^0.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
