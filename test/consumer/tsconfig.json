{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "foley": ["../../dist/index.d.ts"],
      "foley/react": ["../../dist/react.d.ts"],
      "foley/presets": ["../../dist/presets.d.ts"]
    }
  },
  "files": ["usage.tsx"]
}
